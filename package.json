{
  "name": "presencify-backend",
  "version": "1.0.0",
  "description": "A Backend server providing RESTful API for managing data within presencify College management app.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start": "node src/server.js",
    "dev": "nodemon -r ./src/polyfill.cjs src/server.js",
    "seq-mig": "npx sequelize-cli db:migrate",
    "seq-undo": "npx sequelize-cli db:migrate:undo",
    "seq-undo-name": "npx sequelize-cli db:migrate:undo --name",
    "seq-undo-all": "npx sequelize-cli db:migrate:undo:all",
    "seq-mig-gen": "npx sequelize-cli migration:generate --name",
    "reset-db": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "test-mig": "NODE_ENV=test npx sequelize-cli db:migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahilshivekar/presencify-backend.git"
  },
  "author": "Sahil Shivekar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sahilshivekar/presencify-backend/issues"
  },
  "homepage": "https://github.com/sahilshivekar/presencify-backend#readme",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.1.2",
    "jest": "^30.1.3",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@faker-js/faker": "^10.0.0",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.12",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.2",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^14.0.0",
    "fs": "^0.0.1-security",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "http-status-codes": "^2.3.0",
    "jimp": "^1.6.0",
    "joi": "^17.13.3",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.20",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-mocks-http": "^1.17.2",
    "nodemailer": "^9.0.3",
    "onnxruntime-node": "^1.24.3",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5",
    "supertest": "^7.1.4",
    "undici": "^8.4.1",
    "uuid": "^14.0.1",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4"
  }
}
